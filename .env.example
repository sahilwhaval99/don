# DON (Digital Operations Navigator) - Root Environment Configuration Example
# Copy to .env for local overrides. Do NOT commit actual secrets.

# Environment
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://don_user:don_password@localhost:5432/don_db?schema=public

# Security & Authentication
JWT_SECRET=your-256-bit-secret-must-be-at-least-32-chars-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
ENCRYPTION_KEY=32-byte-hex-encoded-secret-key-for-credentials-at-rest

# AI Provider Configuration
# Supported providers: "mock" (default, deterministic), "gemini", "openai"
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_placeholder
OPENAI_API_KEY=your_openai_api_key_placeholder

# Web Search Provider Configuration
# Supported: "mock", "brave", "tavily"
SEARCH_PROVIDER=mock
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_placeholder
TAVILY_API_KEY=your_tavily_api_key_placeholder

# Desktop Agent & Android Companion Relay Secret
RELAY_HMAC_SECRET=your-relay-mutual-authentication-secret

# Cloud Run Configuration
CLOUD_RUN_SERVICE_NAME=don-api
CLOUD_RUN_REGION=us-central1
